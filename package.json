{
  "name": "whipwhip",
  "version": "0.1.1",
  "private": true,
  "productName": "WhipWhip",
  "description": "An interactive desktop armory of colorful whips",
  "author": {
    "name": "AMIRSRAD",
    "url": "https://github.com/AMIRSRAD"
  },
  "license": "MIT",
  "homepage": "https://github.com/AMIRSRAD/WhipWhip#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AMIRSRAD/WhipWhip.git"
  },
  "bugs": {
    "url": "https://github.com/AMIRSRAD/WhipWhip/issues"
  },
  "main": "main.js",
  "bin": {
    "whipwhip": "bin/whipwhip.js"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "electron",
    "tray",
    "overlay",
    "cli"
  ],
  "files": [
    "main.js",
    "preload.js",
    "overlay.html",
    "sounds",
    "icon",
    "bin/whipwhip.js",
    "README.md"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --show-armory",
    "check": "node scripts/check.js",
    "pack": "npm pack",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:dir": "electron-builder --dir --win --x64"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.whipwhip.desktop",
    "productName": "WhipWhip",
    "executableName": "WhipWhip",
    "asar": true,
    "asarUnpack": [
      "node_modules/koffi/**/*"
    ],
    "compression": "maximum",
    "npmRebuild": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "package.json",
      "LICENSE",
      "sounds/**/*",
      "icon/**/*"
    ],
    "win": {
      "icon": "icon/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WhipWhip",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "license": "LICENSE"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}",
      "requestExecutionLevel": "user"
    },
    "publish": {
      "provider": "github",
      "owner": "AMIRSRAD",
      "repo": "WhipWhip"
    }
  }
}
